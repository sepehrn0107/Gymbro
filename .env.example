# Database — use localhost:5432 when running Next.js on host with Postgres in Docker
# Use the Docker service name (e.g. "db") when running Next.js inside Docker compose
DATABASE_URL="postgresql://gymbro:gymbro@localhost:5432/gymbro"

# Auth.js — used for CSRF/cookie signing (not a JWT secret; session strategy is "database")
# Generate with: openssl rand -base64 32
AUTH_SECRET="w8kTfmQPqbSU7bxmD1gTm7vz1AHEL1SNr+Nf4L729iI="

# Google OAuth (register at https://console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Dev autologin — set to a seeded user's email to bypass the login flow entirely.
# Only active when NODE_ENV != "production". Leave blank to use normal auth.
DEV_AUTOLOGIN_EMAIL=""

# Email (nodemailer SMTP)
# For local dev use Ethereal (free, no sign-up): https://ethereal.email
EMAIL_FROM="GymBro <noreply@gymbro.local>"
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
